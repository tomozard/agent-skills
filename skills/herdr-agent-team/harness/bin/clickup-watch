#!/usr/bin/env python3
"""clickup-watch — ClickUp intake for the Herdr desktop-app agent team.

Polls one ClickUp list for tasks in the trigger status, works out which
registered project the task belongs to, and pushes a task brief to that
project's PM pane (or asks the Orchestrator to open the PM). It uses the
already-authenticated ClickUp MCP the Pi/Claude runtimes use, over plain
HTTP — no personal API token, no LLM turn per poll.

Usage:
  clickup-watch once      one poll, then exit (--dry-run, --fixture FILE)
  clickup-watch loop      poll forever every --interval seconds (default 600)
  clickup-watch start     start the kept watcher terminal in Herdr
  clickup-watch stop      stop the watcher terminal
  clickup-watch status    watcher terminal, last poll, last dispatch

Intake contract (Human-approved):
  - trigger status is `to do`
  - a dispatched task becomes `in progress` and gets a ClickUp comment, so the
    next poll does not pick it up again
  - a task whose project cannot be resolved with confidence goes back to the
    Human as `discuss` with a comment naming what is missing
  - the brief never grants scope, commit, push, or PR authority: PM must put a
    plan to the Human in its own pane before any implementation starts
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

#!/usr/bin/env bash
# One-command install for herdr-agent-team.
#
#   npx -y github:tomozard/agent-skills --yes
#
# The skills CLI copies files only and cannot run install scripts, so this
# wrapper runs both layers: `npx skills add` for the policy layer, then the
# payload's own setup_harness.sh for the runtime layer. The Human orders the
# install by passing --yes; without it only the plan is printed.
#
# Before anything is written it checks that Herdr is installed, because the team
# runs inside the Herdr desktop app and this skill installs Herdr for nobody. A
# missing Herdr prints the download page and the official installer and exits 3;
# --allow-no-herdr installs the harness anyway (a machine that is being prepared).
set -euo pipefail

# npx runs this file through a symlink in node_modules/.bin, so resolve the real
# path before walking up: otherwise ".." is node_modules and the payload is lost.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  SELF_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in
    /*) ;;
    *) SELF="$SELF_DIR/$SELF" ;;
  esac
done
PACKAGE_ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"
SKILL_REPO="tomozard/agent-skills/skills/herdr-agent-team"
AGENTS="pi claude-code"
SKILL_DIR="${HERDR_AGENT_TEAM_SKILL_DIR:-$HOME/.agents/skills/herdr-agent-team}"
INSTALLER="$SKILL_DIR/harness/setup_harness.sh"
HTEAM="$HOME/bin/hteam"
LOG_DIR="$HOME/.config/herdr"
LOG_FILE="$LOG_DIR/install.log"

SKIP_VALIDATE=0
ASSUME_YES=0
DRY_RUN=0
ALLOW_NO_HERDR=0

usage() {
  cat <<'EOF'
Usage: herdr-install [install|health|version] [options]

  install (default)  install the policy layer and the runtime, then verify
  health [--json]    machine readiness; writes nothing and starts no model
  version            print the package version

Health runs before anything is installed, so a fresh machine can be inspected
with no side effects:  npx -y github:tomozard/agent-skills health

Install options:

  --yes              run the install; without it only the plan is printed
  --dry-run          print the plan and the Herdr preflight, exit 0
  --skip-validate    skip tests/validate.sh (only after machine-local routing edits)
  --allow-no-herdr   install even though the Herdr desktop app is missing

Exit codes: 0 ok, 1 waiting for --yes, 2 bad arguments, 3 Herdr is missing.
EOF
}

# Subcommands. `install` stays the default so the previous one-argument form keeps
# working; `health` and `version` never touch $HOME.
health_dispatch() {
  local bin="$PACKAGE_ROOT/skills/herdr-agent-team/harness/bin/hteam-health"
  if [ ! -x "$bin" ]; then
    bin="$(command -v hteam-health 2>/dev/null || true)"
  fi
  if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "herdr-install: health checker not found in the package" >&2
    exit 2
  fi
  exec "$bin" "$@"
}

version_dispatch() {
  python3 -c 'import json,sys;print(json.load(open(sys.argv[1],encoding="utf-8"))["version"])' \
    "$PACKAGE_ROOT/package.json" 2>/dev/null || echo unknown
}

COMMAND="install"
case "${1:-}" in
  install) COMMAND="install"; shift ;;
  health) COMMAND="health"; shift ;;
  version|--version) COMMAND="version"; shift ;;
  setup) COMMAND="setup"; shift ;;
esac

case "$COMMAND" in
  health) health_dispatch "$@" ;;
  version) version_dispatch; exit 0 ;;
  setup)
    echo "herdr-install: setup is not implemented yet." >&2
    echo "  install the harness, then configure it with hteam-config or /hteam setup" >&2
    exit 2
    ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --yes|-y) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --skip-validate) SKIP_VALIDATE=1 ;;
    --allow-no-herdr) ALLOW_NO_HERDR=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "herdr-install: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

plan() {
  echo "herdr-install: plan"
  echo "  1. npx -y skills add $SKILL_REPO -g -y -a $AGENTS"
  if [ "$SKIP_VALIDATE" = 1 ]; then
    echo "  2. $INSTALLER --skip-validate"
  else
    echo "  2. $INSTALLER"
  fi
  echo "  3. $HTEAM check --deep"
  echo "  log: $LOG_FILE"
}

HERDR_DOWNLOAD="https://herdr.dev/download/"
HERDR_INSTALL_MAC_LINUX="curl -fsSL https://releases.herdr.dev/app/install.sh | sh"
HERDR_INSTALL_WINDOWS="irm https://releases.herdr.dev/app/install.ps1 | iex"

find_herdr() {
  HERDR_APP=""
  HERDR_CORE=""
  if [ -n "${HERDR_APP_BIN:-}" ]; then
    HERDR_APP="$HERDR_APP_BIN"
  elif [ -x "$HOME/.local/bin/herdr-app" ]; then
    HERDR_APP="$HOME/.local/bin/herdr-app"
  elif command -v herdr-app >/dev/null 2>&1; then
    HERDR_APP="$(command -v herdr-app)"
  fi
  if [ -n "${HC_BIN:-}" ]; then
    HERDR_CORE="$HC_BIN"
  elif [ -x "$HOME/.local/bin/herdr-core" ]; then
    HERDR_CORE="$HOME/.local/bin/herdr-core"
  elif command -v herdr-core >/dev/null 2>&1; then
    HERDR_CORE="$(command -v herdr-core)"
  fi
}

herdr_version() {
  "$1" --version 2>/dev/null | head -n 1 | awk '{print $NF}' || true
}

# Exit 3 when Herdr is missing. Writes nothing.
preflight_herdr() {
  find_herdr
  local missing=0
  echo "herdr-install: preflight"
  if [ -n "$HERDR_APP" ] && [ -x "$HERDR_APP" ]; then
    echo "  ok:   herdr-app $(herdr_version "$HERDR_APP") ($HERDR_APP)"
  else
    echo "  MISS: herdr-app (the team runs inside the Herdr desktop app)" >&2
    missing=1
  fi
  if [ -n "$HERDR_CORE" ] && [ -x "$HERDR_CORE" ]; then
    echo "  ok:   herdr-core $(herdr_version "$HERDR_CORE") ($HERDR_CORE)"
  else
    echo "  MISS: herdr-core (Herdr installs it when the app opens once)" >&2
    missing=1
  fi
  [ "$missing" = 0 ] && return 0

  cat >&2 <<EOF

herdr-install: install Herdr first, then re-run this command
  download:    $HERDR_DOWNLOAD
  macOS/Linux: $HERDR_INSTALL_MAC_LINUX
  Windows:     $HERDR_INSTALL_WINDOWS
               (this harness is macOS-only today; Herdr itself runs there)
  Open Herdr once afterwards so herdr-core is set up.
  To install the harness anyway: herdr-install --yes --allow-no-herdr
EOF
  return 3
}

plan
HERDR_RC=0
preflight_herdr || HERDR_RC=$?
if [ "$HERDR_RC" = 3 ] && [ "$ALLOW_NO_HERDR" = 1 ]; then
  echo "herdr-install: continuing without Herdr (--allow-no-herdr)" >&2
  HERDR_RC=0
fi
[ "$DRY_RUN" = 1 ] && exit 0
[ "$HERDR_RC" = 3 ] && exit 3
if [ "$ASSUME_YES" != 1 ]; then
  echo >&2
  echo "herdr-install: re-run with --yes to install (the Human orders this step)." >&2
  exit 1
fi

mkdir -p "$LOG_DIR"
printf '%s herdr-install start user=%s skip_validate=%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${USER:-unknown}" "$SKIP_VALIDATE" >>"$LOG_FILE"

echo "herdr-install: skill layer"
npx -y skills add "$SKILL_REPO" -g -y -a $AGENTS

echo "herdr-install: runtime layer"
if [ "$SKIP_VALIDATE" = 1 ]; then
  "$INSTALLER" --skip-validate
else
  "$INSTALLER"
fi

echo "herdr-install: verify"
if "$HTEAM" check --deep; then
  printf '%s herdr-install done\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG_FILE"
  echo "herdr-install: done — run 'hteam' to open a team, or '/hteam setup' in Pi"
else
  printf '%s herdr-install check-failed\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG_FILE"
  echo "herdr-install: check --deep failed; rerun $INSTALLER and read the MISS lines" >&2
  exit 1
fi
